body {
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

.app-container {
  padding: 20px;
  font-family: Arial, sans-serif;
}

#app {
  padding: 20px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.header h1 {
  margin: 0;
}

.btn {
  padding: 8px 16px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
}

.btn-primary {
  background-color: #0052CC;
  color: white;
}

.btn-primary:hover {
  background-color: #0065FF;
}

.btn-toggle {
  background-color: #f5cd47;
  color: #000;
  border: 1px solid #974F0C;
  margin-right: 8px;
}

.btn-delete {
  background-color: #AE2A19;
  color: white;
  border: none;
}

.rule-card {
  border: 1px solid #DFE1E6;
  border-radius: 4px;
  padding: 16px;
  margin-bottom: 12px;
  background-color: #F1F2F4;
}

.rule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.rule-header h3 {
  margin: 0;
}

.rule-actions {
  display: flex;
  gap: 8px;
}

.rule-details {
  color: #626f86;
  font-size: 14px;
  line-height: 1.5;
}

.error {
  padding: 16px;
  background-color: #ffebe6;
  border: 1px solid #de350b;
  border-radius: 4px;
  color: #de350b;
  margin-bottom: 20px;
}

.loading {
  text-align: center;
  padding: 40px 20px;
  color: #626f86;
}

.empty {
  text-align: center;
  padding: 40px 20px;
  color: #626f86;
}
}

.error-small {
  margin-top: 8px;
  display: block;
}

.reload-btn {
  margin-top: 8px;
  padding: 8px 16px;
  background-color: #0052CC;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

.loading-container {
  padding: 20px;
  text-align: center;
}

.empty-state {
  padding: 40px;
  text-align: center;
  background-color: #f4f5f7;
  border-radius: 4px;
  color: #6b778c;
}

.empty-state-title {
  font-size: 16px;
  margin-bottom: 10px;
}

.empty-state-subtitle {
  font-size: 14px;
}

.rules-grid {
  display: grid;
  gap: 16px;
}

.rule-card {
  border: 1px solid #dfe1e6;
  border-radius: 4px;
  padding: 16px;
  background-color: white;
}

.rule-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.rule-info {
  flex: 1;
}

.rule-name {
  margin: 0 0 8px 0;
  font-size: 16px;
  font-weight: bold;
}

.rule-meta {
  display: flex;
  gap: 16px;
  margin-bottom: 8px;
  font-size: 14px;
  color: #6b778c;
}

.rule-actions {
  display: flex;
  gap: 8px;
}

.btn {
  padding: 6px 12px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
}

.btn-toggle-enabled {
  background-color: #f4f5f7;
  color: #42526e;
}

.btn-toggle-disabled {
  background-color: #0052CC;
  color: white;
}

.btn-edit {
  background-color: #f4f5f7;
  color: #42526e;
}

.btn-delete {
  background-color: #de350b;
  color: white;
}

.status-badge {
  padding: 2px 8px;
  border-radius: 3px;
  font-weight: bold;
  font-size: 12px;
}

.status-enabled {
  background-color: #e3fcef;
  color: #006644;
}

.status-disabled {
  background-color: #f4f5f7;
  color: #6b778c;
}

.rule-details {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #dfe1e6;
}

.detail-section {
  margin-bottom: 8px;
}

.detail-label {
  font-size: 13px;
  color: #42526e;
  font-weight: bold;
}

.detail-list {
  margin: 4px 0 0 0;
  padding-left: 20px;
  font-size: 13px;
  color: #6b778c;
}
/* Form Styles */
.form-container {
  background-color: #F1F2F4;
  border: 1px solid #DFE1E6;
  border-radius: 4px;
  padding: 20px;
  max-width: 500px;
}

.form-group {
  margin-bottom: 16px;
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-weight: 600;
  margin-bottom: 6px;
  font-size: 14px;
  color: #42526E;
}

.form-group input,
.form-group textarea,
.form-group select {
  padding: 8px 12px;
  border: 1px solid #DFE1E6;
  border-radius: 4px;
  font-size: 14px;
  font-family: inherit;
  background-color: white;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  outline: none;
  border-color: #0052CC;
  box-shadow: 0 0 0 2px rgba(0, 82, 204, 0.1);
}

.form-group textarea {
  resize: vertical;
  min-height: 80px;
}

.form-actions {
  display: flex;
  gap: 8px;
  margin-top: 20px;
}

.form-actions button {
  flex: 1;
}